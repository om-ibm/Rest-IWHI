CREATE COMPUTE MODULE OpenScale_TraditionalML_FormatPayload
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.HTTPResponseHeader."Content-Type" = 'application/json';

		-- Source References
		DECLARE src REFERENCE TO InputRoot.JSON.Data;
		DECLARE dataRef REFERENCE TO src.data;

		-- Initialize Target JSON Output
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outRef REFERENCE TO OutputRoot.JSON.Data;

		-- 1. Extract Instances (Request fields & values)
		-- All items in "instances" array: keys go into "fields", values go into "values" array
		CREATE FIELD outRef.request.fields IDENTITY (JSON.Array)fields;
		CREATE FIELD outRef.request.values IDENTITY (JSON.Array)values;

		DECLARE instCount INTEGER CARDINALITY(dataRef.request.instances.Item[]);
		IF instCount > 0 THEN
			-- Populate fields array from first instance object
			DECLARE firstInst REFERENCE TO dataRef.request.instances.Item[1];
			DECLARE fieldRef REFERENCE TO firstInst.*[1];
			DECLARE fIdx INTEGER 1;
			WHILE LASTMOVE(fieldRef) DO
				SET outRef.request.fields.Item[fIdx] = FIELDNAME(fieldRef);
				SET fIdx = fIdx + 1;
				MOVE fieldRef NEXTSIBLING;
			END WHILE;

			-- Populate values matrix for all instances
			DECLARE rIdx INTEGER 1;
			WHILE rIdx <= instCount DO
				CREATE FIELD outRef.request.values.Item[rIdx] IDENTITY (JSON.Array)Item;
				DECLARE curInst REFERENCE TO dataRef.request.instances.Item[rIdx];
				DECLARE valRef REFERENCE TO curInst.*[1];
				DECLARE vIdx INTEGER 1;
				WHILE LASTMOVE(valRef) DO
					SET outRef.request.values.Item[rIdx].Item[vIdx] = FIELDVALUE(valRef);
					SET vIdx = vIdx + 1;
					MOVE valRef NEXTSIBLING;
				END WHILE;
				SET rIdx = rIdx + 1;
			END WHILE;
		END IF;

		-- 2. Extract Predictions (Response fields & values)
		CREATE FIELD outRef.response.fields IDENTITY (JSON.Array)fields;
		SET outRef.response.fields.Item[1] = 'prediction';

		CREATE FIELD outRef.response.values IDENTITY (JSON.Array)values;
		DECLARE predCount INTEGER CARDINALITY(dataRef.response.predictions.Item[]);
		IF predCount > 0 THEN
			DECLARE pIdx INTEGER 1;
			WHILE pIdx <= predCount DO
				CREATE FIELD outRef.response.values.Item[pIdx] IDENTITY (JSON.Array)Item;
				-- Each prediction item can be an array of numbers or single value
				IF CARDINALITY(dataRef.response.predictions.Item[pIdx].Item[]) > 0 THEN
					DECLARE subCount INTEGER CARDINALITY(dataRef.response.predictions.Item[pIdx].Item[]);
					DECLARE sIdx INTEGER 1;
					WHILE sIdx <= subCount DO
						SET outRef.response.values.Item[pIdx].Item[sIdx] = dataRef.response.predictions.Item[pIdx].Item[sIdx];
						SET sIdx = sIdx + 1;
					END WHILE;
				ELSE
					SET outRef.response.values.Item[pIdx].Item[1] = dataRef.response.predictions.Item[pIdx];
				END IF;
				SET pIdx = pIdx + 1;
			END WHILE;
		END IF;

		-- 3. Identifiers, Timestamps and Model Settings
		SET outRef.scoring_id = COALESCE(dataRef.transactionid, src.message_id, UUIDASCHAR);

		-- Convert response_time_stamp to ISO-8601 UTC
		DECLARE epochMs INTEGER CAST(dataRef.response_time_stamp AS INTEGER);
		SET outRef.scoring_timestamp = ConvertEpochToIsoUtc(epochMs);

		SET outRef.response_time = CAST(dataRef.response_time AS INTEGER);
		SET outRef.asset_revision = 'v1.0.0';
		SET outRef.multiple_records = FALSE;

		-- User_id must be an imputed UUID for Traditional ML
		SET outRef.user_id = UUIDASCHAR;

		-- No input or output tokens for Traditional ML
		SET outRef.input_tokens = NULL;
		SET outRef.output_tokens = NULL;

		RETURN TRUE;
	END;

	CREATE FUNCTION ConvertEpochToIsoUtc(IN epochMillis INTEGER) RETURNS CHARACTER
	BEGIN
		IF epochMillis IS NULL OR epochMillis = 0 THEN
			RETURN CAST(CURRENT_GMTTIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSS''Z''');
		END IF;
		DECLARE secCount INTEGER epochMillis / 1000;
		DECLARE remMillis INTEGER MOD(epochMillis, 1000);
		DECLARE baseEpoch TIMESTAMP TIMESTAMP '1970-01-01 00:00:00.000';
		DECLARE eventTs TIMESTAMP baseEpoch + CAST(secCount AS INTERVAL SECOND);
		RETURN CAST(eventTs AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss') || '.' || RIGHT('000' || CAST(remMillis AS CHARACTER), 3) || 'Z';
	END;
END MODULE;

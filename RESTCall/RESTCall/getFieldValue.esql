CREATE FUNCTION getFieldValue(IN fieldRef REFERENCE) RETURNS CHARACTER
BEGIN
	LOG EVENT SEVERITY 2 CATALOG 'BIPmsgs' MESSAGE 8099 VALUES('In getFieldValue', '', '');
    RETURN 'abc';
END;


CREATE FUNCTION getFieldValueByNumber(IN fieldRef REFERENCE, IN index INTEGER) RETURNS CHARACTER
BEGIN
	LOG EVENT SEVERITY 2 CATALOG 'BIPmsgs' MESSAGE 8099 VALUES('In getFieldValueByNumber', '', index);
    RETURN 'abc';
END;

CREATE FUNCTION getFieldValueOnlyByNumber(IN index INTEGER) RETURNS CHARACTER
BEGIN
	LOG EVENT SEVERITY 2 CATALOG 'BIPmsgs' MESSAGE 8099 VALUES('In getFieldValueOnlyByNumber', '', index);
    RETURN 'def';
END;
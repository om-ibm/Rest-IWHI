{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://openscale.ibm.com/schema/genai-source.schema.json",
  "title": "GenAISourceModel",
  "description": "Message model for Generative AI LLM scoring and chat completion payloads",
  "type": "object",
  "required": [
    "message_id",
    "data"
  ],
  "properties": {
    "message_id": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "transactionid",
        "response_time_stamp",
        "response_time",
        "request",
        "response"
      ],
      "properties": {
        "transactionid": {
          "type": "string"
        },
        "response_time_stamp": {
          "type": "integer"
        },
        "response_time": {
          "type": "integer"
        },
        "request": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "content"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            },
            "temperature": {
              "type": "number"
            },
            "stream": {
              "type": "boolean"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "function": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "parameters": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "finish_reason": {
                    "type": "string"
                  },
                  "index": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      },
                      "extra_content": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            },
            "created": {
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "usage": {
              "type": "object",
              "properties": {
                "prompt_tokens": {
                  "type": "integer"
                },
                "completion_tokens": {
                  "type": "integer"
                },
                "completion_tokens_details": {
                  "type": "object",
                  "properties": {
                    "reasoning_tokens": {
                      "type": "integer"
                    }
                  }
                },
                "total_tokens": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "request_headers": {
          "type": "object",
          "properties": {
            "x-request-id": {
              "type": "string"
            },
            "x-transaction-id": {
              "type": "string"
            },
            "transId": {
              "type": "string"
            },
            "transactionSrc": {
              "type": "string"
            }
          }
        },
        "response_headers": {
          "type": "object"
        }
      }
    },
    "attributes": {
      "type": "object",
      "properties": {
        "sub_topic": {
          "type": "string"
        }
      }
    },
    "publish_time": {
      "type": "string"
    },
    "ack_id": {
      "type": "string"
    }
  }
}

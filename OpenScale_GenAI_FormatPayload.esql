CREATE COMPUTE MODULE OpenScale_GenAI_FormatPayload
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.HTTPResponseHeader."Content-Type" = 'application/json';

		-- Preserve source reference
		DECLARE src REFERENCE TO InputRoot.JSON.Data;
		DECLARE dataRef REFERENCE TO src.data;

		-- Initialize OpenScale JSON target
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outRef REFERENCE TO OutputRoot.JSON.Data;

		-- 1. Request Fields & Values
		-- Fields = ["prompt", "context", "user_query"]
		CREATE FIELD outRef.request.fields IDENTITY (JSON.Array)fields;
		SET outRef.request.fields.Item[1] = 'prompt';
		SET outRef.request.fields.Item[2] = 'context';
		SET outRef.request.fields.Item[3] = 'user_query';

		-- Compute prompt (messages[1] / first message)
		DECLARE promptText CHARACTER '';
		IF EXISTS(dataRef.request.messages.Item[1].content[]) THEN
			SET promptText = dataRef.request.messages.Item[1].content;
		END IF;

		-- Compute context (concatenation of all tools description)
		DECLARE toolContext CHARACTER '';
		DECLARE toolCount INTEGER CARDINALITY(dataRef.request.tools.Item[]);
		DECLARE tIdx INTEGER 1;
		WHILE tIdx <= toolCount DO
			IF EXISTS(dataRef.request.tools.Item[tIdx].function.description[]) THEN
				IF toolContext <> '' THEN
					SET toolContext = toolContext || ' | ' || dataRef.request.tools.Item[tIdx].function.description;
				ELSE
					SET toolContext = dataRef.request.tools.Item[tIdx].function.description;
				END IF;
			END IF;
			SET tIdx = tIdx + 1;
		END WHILE;

		-- Compute user_query (last message content)
		DECLARE msgCount INTEGER CARDINALITY(dataRef.request.messages.Item[]);
		DECLARE userQueryText CHARACTER '';
		IF msgCount > 0 THEN
			SET userQueryText = dataRef.request.messages.Item[msgCount].content;
		END IF;

		CREATE FIELD outRef.request.values IDENTITY (JSON.Array)values;
		CREATE FIELD outRef.request.values.Item[1] IDENTITY (JSON.Array)Item;
		SET outRef.request.values.Item[1].Item[1] = promptText;
		SET outRef.request.values.Item[1].Item[2] = toolContext;
		SET outRef.request.values.Item[1].Item[3] = userQueryText;

		-- 2. Response Fields & Values
		-- Fields = ["response"]
		CREATE FIELD outRef.response.fields IDENTITY (JSON.Array)fields;
		SET outRef.response.fields.Item[1] = 'response';

		DECLARE respContent CHARACTER '';
		IF EXISTS(dataRef.response.choices.Item[1].message.content[]) THEN
			SET respContent = dataRef.response.choices.Item[1].message.content;
		END IF;

		CREATE FIELD outRef.response.values IDENTITY (JSON.Array)values;
		CREATE FIELD outRef.response.values.Item[1] IDENTITY (JSON.Array)Item;
		SET outRef.response.values.Item[1].Item[1] = respContent;

		-- 3. Identifiers & Metadata
		SET outRef.scoring_id = COALESCE(dataRef.transactionid, src.message_id, UUIDASCHAR);
		
		-- Convert response_time_stamp (epoch ms) to ISO-8601 UTC string
		DECLARE epochMs INTEGER CAST(dataRef.response_time_stamp AS INTEGER);
		SET outRef.scoring_timestamp = ConvertEpochToIsoUtc(epochMs);

		SET outRef.response_time = CAST(dataRef.response_time AS INTEGER);
		SET outRef.asset_revision = 'v1.0.0';
		SET outRef.multiple_records = FALSE;

		-- user_id = request_headers.x-request-id
		SET outRef.user_id = COALESCE(dataRef.request_headers."x-request-id", UUIDASCHAR);

		-- Tokens
		SET outRef.input_tokens = CAST(dataRef.response.usage.prompt_tokens AS INTEGER);
		DECLARE compTokens INTEGER COALESCE(CAST(dataRef.response.usage.completion_tokens AS INTEGER), 0);
		DECLARE reasonTokens INTEGER COALESCE(CAST(dataRef.response.usage.completion_tokens_details.reasoning_tokens AS INTEGER), 0);
		SET outRef.output_tokens = compTokens + reasonTokens;

		RETURN TRUE;
	END;

	-- Helper function to format timestamp
	CREATE FUNCTION ConvertEpochToIsoUtc(IN epochMillis INTEGER) RETURNS CHARACTER
	BEGIN
		-- Standard fallback format if timestamp is present
		IF epochMillis IS NULL OR epochMillis = 0 THEN
			RETURN CAST(CURRENT_GMTTIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSS''Z''');
		END IF;
		-- 1781544611483 ms -> 2026-06-15T17:30:11.483Z
		DECLARE secCount INTEGER epochMillis / 1000;
		DECLARE remMillis INTEGER MOD(epochMillis, 1000);
		DECLARE baseEpoch TIMESTAMP TIMESTAMP '1970-01-01 00:00:00.000';
		DECLARE eventTs TIMESTAMP baseEpoch + CAST(secCount AS INTERVAL SECOND);
		RETURN CAST(eventTs AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss') || '.' || RIGHT('000' || CAST(remMillis AS CHARACTER), 3) || 'Z';
	END;
END MODULE;
